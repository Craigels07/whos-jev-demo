{
  "name": "whos-jev",
  "version": "1.0.0",
  "description": "Who's Jev: seven examples of TypeSafe's System One decision model, from a single yes or no in code to guardrail and compaction hooks inside the pi agent.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "demo": "JEV_BACKEND=mock node src/example.ts",
    "demo:live": "node src/example.ts",
    "web": "node server/server.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:live": "JEV_LIVE=1 JEV_BACKEND=typesafe node --test \"tests/live.test.ts\"",
    "web:build": "cd web && npm run build"
  }
}
